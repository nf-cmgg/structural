nextflow_pipeline {

    name "Test Workflow main.nf"
    script "main.nf"

    tag "pipeline"
    tag "pipeline_cnv"

    options "-stub"

    test("one caller") {

        when {
            params {
                outdir = "${outputDir}"
                callers = "qdnaseq"
                max_cpus   = 2
                max_memory = '6.GB'
                max_time   = '6.h'
            }
        }

        then {
            assertAll(
                { assert workflow.success },
                { assert snapshot(
                    path("${outputDir}")
                        .list()
                        .collect { Utils.getRecursiveFileNames(it, "${outputDir}") }
                        .flatten()
                        .findAll {
                            !it.contains("pipeline_info/")
                        }
                ).match("qdnaseq")}
            )
        }

    }

    test("all callers") {

        when {
            params {
                outdir = "${outputDir}"
                callers = "cnv"
                max_cpus   = 2
                max_memory = '6.GB'
                max_time   = '6.h'
            }
        }

        then {
            assertAll(
                { assert workflow.success },
                { assert snapshot(
                    path("${outputDir}")
                        .list()
                        .collect { Utils.getRecursiveFileNames(it, "${outputDir}") }
                        .flatten()
                        .findAll {
                            !it.contains("pipeline_info/")
                        }
                ).match("all")}
            )
        }

    }

}
